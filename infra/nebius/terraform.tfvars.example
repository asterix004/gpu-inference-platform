# Copy to terraform.tfvars (git-ignored) or let `make env` export TF_VAR_* for you.
project_id = "project-xxxxxxxxxxxxxxxxxxxx"
subnet_id  = "vpcsubnet-xxxxxxxxxxxxxxxxxxxx"

# System pool: 1 node fits the default quota of 2 compute instances (1 system + 1 GPU).
# Set to 0 until the non-GPU vCPU quota is approved.
cpu_node_count = 1

# GPU pool: 1 x L40S. Set to 0 between sessions to stop GPU billing
# while keeping the cluster (control plane + system pool still bill).
gpu_node_count = 1
gpu_platform   = "gpu-l40s-a"
gpu_preset     = "1gpu-8vcpu-32gb"

# Second benchmark run, same workload on an H100:
# gpu_platform = "gpu-h100-sxm"
# gpu_preset   = "1gpu-16vcpu-200gb"
